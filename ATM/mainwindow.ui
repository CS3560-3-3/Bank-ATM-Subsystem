      <string notr="true">QLineEdit {
    background-color: #b7c0bb;        /* soft gray-green like ATM input fields */
    color: #ffffff;                   /* white text */
    font: 18px &quot;Segoe UI&quot;;
    padding: 6px 10px;
    border: 2px solid #8fa29a;        /* slightly darker accent */
    border-radius: 10px;
    selection-background-color: #4A90E2;  /* blue highlight */
    selection-color: white;
}

QLineEdit:hover {
    background-color: #c3ccc6;
}

QLineEdit:focus {
    background-color: #d3dbd6;
