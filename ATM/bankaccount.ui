     <string notr="true">text {
color: Black;
}

/* ---------- TAB BAR CONTAINER ---------- */
QTabWidget::pane {
    border: 0px;
    padding: 5px;
}

/* ---------- TAB BAR ---------- */
QTabBar {
    background: transparent;
}

/* ---------- DEFAULT TABS ---------- */
QTabBar::tab {
    color: white;
    background: #2d2d2d;
    padding: 10px 25px;
    margin-right: 2px;
    font-size: 10px;
    font-weight: bold;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border: 1px solid #444;
}

/* ---------- HOVER EFFECT ---------- */
QTabBar::tab:hover {
    background: #3b3b3b;
    border: 1px solid #666;
}

/* ---------- SELECTED TAB ---------- */
QTabBar::tab:selected {
    background: #5b0f12; /* deep red highlight */
    color: white;
    border: 1px solid #a33238;
}

/* ---------- UNSELECTED TABS ---------- */
QTabBar::tab:!selected {
    background: #2d2d2d;
    color: #d3d3d3;
}
</string>
